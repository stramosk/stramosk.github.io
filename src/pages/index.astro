---
import { Image, getImage } from 'astro:assets';

// Drop photos into src/photos/ — they show up here automatically, sorted by filename.
const photos = await Promise.all(Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../photos/*.{jpg,jpeg,png,webp,avif}', { eager: true })
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(async ([path, mod]) => ({
    src: mod.default,
    // Link a resized copy, never the original file.
    full: (await getImage({ src: mod.default, width: Math.min(1600, mod.default.width), format: 'webp' })).src,
    alt: path.split('/').pop()!.replace(/\.\w+$/, '').replace(/[-_]/g, ' '),
  })));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Vinicius Stramosk</title>
    <meta name="description" content="Software engineer. Photography." />
  </head>
  <body>
    <header>
      <h1>Vinicius Stramosk</h1>
      <p>Software engineer. I take photos sometimes.</p>
      <nav>
        <a href="https://github.com/stramosk">GitHub</a>
        <a href="mailto:stramosk@protonmail.com">Email</a>
      </nav>
    </header>

    <main>
      <h2>Photography</h2>
      {photos.length === 0 && <p class="muted">No photos yet.</p>}
      <div class="grid">
        {photos.map((p) => (
          <a href={p.full} target="_blank">
            <Image src={p.src} alt={p.alt} widths={[400, 800]} sizes="(max-width: 600px) 100vw, 400px" />
          </a>
        ))}
      </div>
    </main>

    <dialog id="viewer" aria-label="Photo viewer">
      <img alt="" />
      <p></p>
    </dialog>
    <script>
      // Links still work without JS; with JS they open in a native <dialog> (Esc closes, focus handled).
      const viewer = document.getElementById('viewer') as HTMLDialogElement;
      const img = viewer.querySelector('img')!;
      const caption = viewer.querySelector('p')!;
      document.querySelectorAll<HTMLAnchorElement>('.grid a').forEach((a) =>
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const thumb = a.querySelector('img')!;
          img.src = a.href;
          img.alt = caption.textContent = thumb.alt;
          viewer.showModal();
        })
      );
      viewer.addEventListener('click', () => viewer.close());
      viewer.addEventListener('close', () => img.removeAttribute('src'));
    </script>

    <footer>© {new Date().getFullYear()} Vinicius Stramosk. All rights reserved.</footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: light dark; --fg: #111; --muted: #777; --bg: #fff; }
  @media (prefers-color-scheme: dark) { :root { --fg: #eee; --muted: #888; --bg: #111; } }
  body { margin: 0 auto; max-width: 1100px; padding: 4rem 1rem; font: 16px/1.6 system-ui, sans-serif; color: var(--fg); background: var(--bg); }
  h1 { font-size: 1.5rem; margin: 0; }
  h2 { font-size: 1rem; font-weight: 500; color: var(--muted); margin: 4rem 0 1rem; }
  a { color: inherit; }
  nav { display: flex; gap: 1rem; }
  footer { margin-top: 4rem; font-size: .875rem; color: var(--muted); }
  .muted { color: var(--muted); }
  .grid { columns: 3 300px; column-gap: 1rem; }
  .grid a { display: block; margin-bottom: 1rem; break-inside: avoid; overflow: hidden; }
  .grid img { width: 100%; height: auto; display: block; transition: filter .4s, transform .4s; }
  /* B&W until hovered/focused; only on devices that can hover, so touch screens keep colour. */
  @media (hover: hover) {
    .grid img { filter: grayscale(1); }
    .grid a:hover img, .grid a:focus-visible img { filter: none; transform: scale(1.05); }
  }
  @media (prefers-reduced-motion: reduce) {
    .grid a:hover img, .grid a:focus-visible img { transform: none; }
  }
  dialog { max-width: 100vw; max-height: 100vh; padding: 0; border: 0; background: none; color: #eee; text-align: center; cursor: zoom-out; }
  dialog::backdrop { background: rgb(0 0 0 / .9); }
  dialog img { display: block; max-width: 95vw; max-height: 88vh; margin: auto; }
  dialog p { margin: .5rem 0 0; font-size: .875rem; text-transform: capitalize; }
</style>
